{
  "manifest_version": 3,
  "name": "AI Hub Memória",
  "version": "1.3.0",
  "minimum_chrome_version": "114",
  "description": "Memória partilhada, injeção inteligente e exportação em Qwen, DeepSeek, ChatGPT, Claude, GLM e Mistral.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI Hub Memória",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "downloads",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://chat.qwen.ai/*",
    "https://chat.qwenlm.ai/*",
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.z.ai/*",
    "https://chatglm.cn/*",
    "https://*.chatglm.cn/*",
    "https://chat.mistral.ai/*",
    "https://api.deepseek.com/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.z.ai/*",
    "https://open.bigmodel.cn/*",
    "https://api.mistral.ai/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_iframes",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.z.ai/*",
        "https://chatglm.cn/*",
        "https://*.chatglm.cn/*",
        "https://chat.mistral.ai/*"
      ],
      "js": [
        "lib/exporter.js",
        "content/sites.js",
        "content/inject.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
